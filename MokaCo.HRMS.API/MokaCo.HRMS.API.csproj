<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MokaCo.HRMS.Model\MokaCo.HRMS.Model.csproj" />
    <ProjectReference Include="..\MokaCo.HRMS.Services\MokaCo.HRMS.Services.csproj" />
  </ItemGroup>

  <!-- The machine's secrets file is never part of a publish: a deployment brings its own. -->
  <ItemGroup>
    <!-- Local developer settings (secrets): never part of a publish -->
    <Content Update="appsettings.Local*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
