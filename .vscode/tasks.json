{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy (dev → test, main → production)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/deploy/deploy.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Deploy API only (dev → test, main → production)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/deploy/deploy.sh",
        "api"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy front end only (dev → test, main → production)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/deploy/deploy.sh",
        "web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
