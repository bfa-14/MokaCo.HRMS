<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- The Recipes page reads an uploaded PDF guide: PDFtoImage (PDFium) draws each page, PdfPig reads its text. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.19.1" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <!-- SkiaSharp's library for Linux (the server): PDFtoImage brings the Windows and macOS ones only. Its version
         must be the SkiaSharp version PDFtoImage resolves (dotnet list package -include-transitive). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MokaCo.HRMS.Model\MokaCo.HRMS.Model.csproj" />
    <ProjectReference Include="..\MokaCo.HRMS.Repository\MokaCo.HRMS.Repository.csproj" />
  </ItemGroup>

</Project>
