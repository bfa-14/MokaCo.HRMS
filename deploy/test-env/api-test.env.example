# deploy/test-env/api-test.env.example -> /etc/mokaco/api-test.env (root:root, mode 0600).
# The TEST API's settings. Fill the <...> values ON THE VM. Never commit the filled file and never
# paste its values into a chat. systemd reads it as written: no quotes, no $ expansion.

# Staging, not Production: behaves the same (only Development differs), and /health says which
# instance answered.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://127.0.0.1:5079
DOTNET_PRINT_TELEMETRY_MESSAGE=false
# Like production's HOME=/var/lib/mokaco: the API keeps its data-protection keys under HOME.
HOME=/var/lib/mokaco-test

# The mokaco_api_test login reaches MokaCo_HRMS_Test ONLY (README step 2), so a typo here cannot
# land in production. Never production's mokaco_api login: it is db_owner on MokaCo_HRMS.
# Password: openssl rand -base64 24 (no ; in it, which would end the connection string).
ConnectionStrings__MokaCo=Server=127.0.0.1;Database=MokaCo_HRMS_Test;User Id=mokaco_api_test;Password=<password from step 2>;TrustServerCertificate=True;

# All three differ from production, so a token issued by one instance is refused by the other.
Jwt__Issuer=MokaCo.HRMS.Test
Jwt__Audience=MokaCo.HRMS.Test.Client
Jwt__SecretKey=<openssl rand -base64 48>

Storage__DocumentsPath=/var/lib/mokaco-test/documents

# Online deposits: the gateway's TEST profile only, never MOKANDCO. The API refuses to start without
# every one of these. There is no test website; BOOKING_SITE_URL only has to be a valid origin.
MPGS_BASE=https://test-bobsal.gateway.mastercard.com
MPGS_MERCHANT_ID=TESTMOKANDCO
MPGS_API_PASSWORD=<TESTMOKANDCO API password>
MPGS_API_VERSION=73
BOOKING_SITE_URL=https://test.hrms.mokanco.com.lb
API_PUBLIC_URL=https://test.hrms.mokanco.com.lb
